{
  "name": "mobx-solid",
  "version": "0.1.0",
  "description": "⚡ MobX bindings for SolidJS — reactive state management with fine-grained UI updates (~0.4 kB gzip)",
  "type": "module",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vitest watch",
    "playground:csr-only": "vite --config playgrounds/csr-only/vite.config.ts",
    "playground:with-ssr": "vite --config playgrounds/with-ssr/vite.config.ts",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "ts:check": "tsc --noEmit -p tsconfig.build.json",
    "check": "pnpm run ts:check && pnpm run test",
    "docs:dev": "docusite dev",
    "docs:build": "docusite build",
    "docs:preview": "docusite preview",
    "changeset:version": "bash scripts/changeset-version.sh",
    "pub": "pnpm build && changeset publish",
    "size-limit": "size-limit"
  },
  "size-limit": [
    {
      "path": "dist/index.js",
      "gzip": true,
      "limit": "0.45 kB"
    }
  ],
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "mobx": "^6.0.0",
    "solid-js": "^1.6.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.1",
    "@size-limit/file": "^13.0.1",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "docusite": "^0.1.12",
    "jsdom": "^26.1.0",
    "mobx": "^6.16.0",
    "size-limit": "^13.0.1",
    "solid-js": "^1.9.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vite-plugin-dts": "^4.5.0",
    "vite-plugin-solid": "^2.11.0",
    "vitest": "^3.2.0"
  },
  "keywords": [
    "mobx",
    "solid",
    "solidjs",
    "reactive",
    "state-management",
    "observer",
    "fine-grained",
    "observable",
    "computed",
    "action",
    "mobx-solid",
    "solid-js",
    "bindings",
    "bridge",
    "ssr",
    "typescript",
    "store",
    "state",
    "reactivity",
    "fine-grained-reactivity",
    "no-vdom"
  ],
  "license": "MIT",
  "homepage": "https://js2me.github.io/mobx-solid",
  "repository": {
    "type": "git",
    "url": "https://github.com/js2me/mobx-solid"
  },
  "packageManager": "pnpm@10.12.1"
}
